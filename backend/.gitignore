node_modules
dist
*.tsbuildinfo

# Keep environment variables out of version control
.env

/src/generated/prisma

# Comprobantes subidos por los usuarios: son datos, no código.
/uploads/*
!/uploads/.gitkeep

# Respaldos de la base (pg_dump): contienen datos de clientes, nunca van a Git.
/respaldos/

# Compilado de los scripts de datos (semilla, demostración, limpieza).
/dist-scripts

# Bases de demostración y de volumen: credenciales y archivos de prueba.
/.demo/
