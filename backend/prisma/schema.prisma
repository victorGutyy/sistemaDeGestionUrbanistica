// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  // Dentro de src/: el compilador de Nest (tsconfig.build.json) exige que
  // todo lo importado esté bajo rootDir "./src".
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoProyecto {
  ACTIVO
  FINALIZADO
}

// El estado de un lote solo cambia mediante acciones del sistema (ver lotes/estado-lote.ts).
enum EstadoLote {
  DISPONIBLE
  SEPARADO
  VENDIDO
  ESCRITURADO
  DESISTIDO
}

// Qué clase de negocio es un proyecto. Solo los de tipo LOTES tienen manzanas y lotes.
enum TipoProyecto {
  LOTES
  REMODELACION
  MAQUINARIA
}

enum TipoEventoLote {
  CREACION
  CAMBIO_ESTADO
  CAMBIO_PRECIO
}

enum FormaPago {
  CONTADO
  FINANCIADO
}

// ACTIVA: el lote está apartado. CONVERTIDA: terminó en una venta. LIBERADA: se canceló la separación.
// ACTIVO cuenta en saldos y caja. ANULADO se conserva visible pero ya no cuenta (nunca se borra).
enum EstadoAbono {
  ACTIVO
  ANULADO
}

enum EstadoSeparacion {
  ACTIVA
  CONVERTIDA
  LIBERADA
}

// PENDIENTE_APROBACION: venta con excepción (cuota inicial baja o plazo largo) que espera al gerente.
// RECHAZADA: el gerente no la autorizó. DESISTIDA: el cliente desistió (se conserva todo el historial).
enum EstadoVenta {
  PENDIENTE_APROBACION
  ACTIVA
  RECHAZADA
  DESISTIDA
}

enum EstadoCuota {
  PENDIENTE
  PARCIAL
  PAGADA
}

// CHEQUE y TARJETA se conservan solo para no invalidar abonos ya
// registrados; el gerente decide cuáles medios están activos en
// MedioPagoConfig.
enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  CHEQUE
  TARJETA
  CONSIGNACION
  NEQUI
  DAVIPLATA
}

enum TipoCuenta {
  AHORROS
  CORRIENTE
  BILLETERA_DIGITAL
}

// Tipo de documento de identidad de un cliente (RF-CLI-01).
enum TipoDocumento {
  CC
  CE
  NIT
  PASAPORTE
  TI
  OTRO
}

enum TipoVendedor {
  ASESOR_INMOBILIARIO
  REFERIDO
}

enum TipoMovimiento {
  INGRESO
  GASTO
}

// Un movimiento anulado se conserva (con quién, cuándo y por qué) pero no suma en ningún total.
// Un cierre de caja cubre un período calendario completo de la empresa (diario, semanal o quincenal).
enum TipoCierre {
  DIARIO
  SEMANAL
  QUINCENAL
}

// BORRADOR: se arma y se recalcula en vivo. CERRADO: el administrador lo congeló y espera al gerente.
// APROBADO: definitivo, no cambia nunca. DEVUELTO: el gerente pidió corregirlo; el administrador lo vuelve a cerrar.
enum EstadoCierre {
  BORRADOR
  CERRADO
  APROBADO
  DEVUELTO
}

enum EstadoMovimiento {
  ACTIVO
  ANULADO
}

// De dónde viene el movimiento: lo escribió una persona o lo generó el sistema.
enum OrigenMovimiento {
  MANUAL
  DEVOLUCION_DESISTIMIENTO
  // El egreso que se crea solo al pagar la comisión de una venta (RF-COM-03).
  COMISION
}

// Estado de la comisión de una venta (RF-COM-02): nace PENDIENTE; se paga o se anula (la pagada también se puede anular).
enum EstadoComision {
  PENDIENTE
  PAGADA
  ANULADA
}

enum EstadoTrabajador {
  ACTIVO
  INACTIVO
}

enum TipoNovedad {
  HORAS_EXTRA
  DESCUENTO
  INCAPACIDAD
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
}

// Rol de un usuario. Los permisos son textos tomados del catálogo fijo que
// vive en el código (src/auth/permisos.ts): cada endpoint exige un permiso y
// el rol dice cuáles tiene. Agregar un rol nuevo (p. ej. jurídico) es agregar
// una fila aquí, sin tocar el código de los módulos.
// Los roles esSistema (GERENTE, ADMINISTRADOR, CONSULTA) no se borran y sus
// permisos se sincronizan desde el código al arrancar la app.
model RolUsuario {
  id                   String    @id @default(uuid())
  clave                String    @unique
  nombre               String
  descripcion          String?
  permisos             String[]
  esSistema            Boolean   @default(false)
  // Solo los roles limitables pueden restringirse a ciertos proyectos (paso 2.2b).
  limitablePorProyecto Boolean   @default(false)
  activo               Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  usuarios             Usuario[]
}

// Cuenta de acceso a la app. No hay registro público: las crea el gerente
// desde la sección de Usuarios.
model Usuario {
  id                        String                 @id @default(uuid())
  nombre                    String
  email                     String                 @unique
  passwordHash              String
  rolId                     String
  rol                       RolUsuario             @relation(fields: [rolId], references: [id])
  estado                    EstadoUsuario          @default(ACTIVO)
  // Bloqueo temporal por intentos fallidos de ingreso.
  intentosFallidos          Int                    @default(0)
  bloqueadoHasta            DateTime?
  ultimoIngreso             DateTime?
  // Las sesiones (tokens) emitidas antes de esta fecha dejan de valer: se usa al restablecer la contraseña.
  sesionesValidasDesde      DateTime?
  // Alcance por proyecto: true = ve todos los proyectos. Si es false, solo ve
  // los de proyectosPermitidos (solo se permite en roles limitablePorProyecto).
  todosLosProyectos         Boolean                @default(true)
  proyectosPermitidos       UsuarioProyecto[]
  historialLotes            LoteHistorial[]
  abonosRegistrados         Abono[]                @relation("AbonosRegistrados")
  abonosAnulados            Abono[]                @relation("AbonosAnulados")
  movimientosRegistrados    MovimientoFinanciero[] @relation("MovimientosRegistrados")
  movimientosAnulados       MovimientoFinanciero[] @relation("MovimientosAnulados")
  cierresCreados            CierreCaja[]           @relation("CierresCreados")
  cierresCerrados           CierreCaja[]           @relation("CierresCerrados")
  cierresResueltos          CierreCaja[]           @relation("CierresResueltos")
  historialCierres          CierreCajaHistorial[]
  registrosAuditoria        RegistroAuditoria[]
  importaciones             Importacion[]
  clientesAutorizados       Cliente[]              @relation("AutorizacionesRegistradas")
  equiposDadosDeBaja        Equipo[]               @relation("EquiposDadosDeBaja")
  comisionesPagadas         Comision[]             @relation("ComisionesPagadas")
  comisionesAnuladas        Comision[]             @relation("ComisionesAnuladas")
  notificaciones            Notificacion[]
  abonosVerificados         Abono[]                @relation("AbonosVerificados")
  recuperacionesPassword    RecuperacionPassword[]
  separacionesRegistradas   Separacion[]
  documentosSubidos         DocumentoVenta[]
  desistimientosRegistrados Desistimiento[]
  ventasRegistradas         Venta[]                @relation("VentasRegistradas")
  ventasResueltas           Venta[]                @relation("VentasResueltas")
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@index([rolId])
}

// Carga de datos desde Excel (RF-MIG-01 a 05). Solo se inserta: queda quién importó, qué archivo (por su huella,
// para no cargar dos veces el mismo), cuánto se creó y el reporte de conciliación de saldos. La carga en sí es una
// sola transacción: si algo falla no queda nada guardado y tampoco este registro.
model Importacion {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  usuarioId     String
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
  nombreArchivo String
  // SHA-256 del archivo: el mismo archivo no se importa dos veces.
  huella        String   @unique
  resumen       Json
  conciliacion  Json

  @@index([createdAt])
}

// Proyectos a los que puede acceder un usuario con alcance restringido.
model UsuarioProyecto {
  usuarioId  String
  proyectoId String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
  createdAt  DateTime @default(now())

  @@id([usuarioId, proyectoId])
  @@index([proyectoId])
}

// Predio de mayor extensión que la empresa compra y subdivide en lotes.
model Proyecto {
  id                String                 @id @default(uuid())
  nombre            String
  ubicacion         String?
  areaTotal         Decimal                @db.Decimal(12, 2)
  valorCompra       Decimal?               @db.Decimal(14, 2)
  fechaCompra       DateTime?
  estado            EstadoProyecto         @default(ACTIVO)
  tipo              TipoProyecto           @default(LOTES)
  municipio         String?
  manzanas          Manzana[]
  lotes             Lote[]
  movimientos       MovimientoFinanciero[]
  equipos           Equipo[]
  usuariosConAcceso UsuarioProyecto[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

// Agrupación opcional de lotes dentro de un proyecto (p. ej. "Manzana A").
// Un proyecto sin manzanas funciona igual: sus lotes quedan sin manzana.
model Manzana {
  id         String   @id @default(uuid())
  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
  nombre     String
  lotes      Lote[]
  createdAt  DateTime @default(now())

  @@unique([proyectoId, nombre])
}

// Subdivisión individual de un Proyecto, en venta.
model Lote {
  id               String          @id @default(uuid())
  proyectoId       String
  proyecto         Proyecto        @relation(fields: [proyectoId], references: [id])
  manzanaId        String?
  manzana          Manzana?        @relation(fields: [manzanaId], references: [id])
  numero           String
  area             Decimal         @db.Decimal(10, 2)
  // Medidas y linderos en texto libre.
  linderos         String?
  // Informativo: el precio de venta es el que manda.
  valorPorM2       Decimal?        @db.Decimal(14, 2)
  valorVenta       Decimal         @db.Decimal(14, 2)
  estado           EstadoLote      @default(DISPONIBLE)
  // Datos de la escritura, cuando el lote pasa a ESCRITURADO.
  escrituraNumero  String?
  escrituraNotaria String?
  escrituraFecha   DateTime?
  ventas           Venta[]
  historial        LoteHistorial[]
  separaciones     Separacion[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // El número es único dentro de su manzana. Para los lotes sin manzana (manzanaId
  // nulo) la unicidad la garantiza un índice parcial escrito a mano en la migración
  // (Prisma no puede expresarlo), además de la revisión en LotesService.
  @@unique([proyectoId, manzanaId, numero])
  @@index([manzanaId])
}

// Bitácora de cada lote: creación, cambios de estado y cambios de precio, con quién y cuándo.
model LoteHistorial {
  id             String         @id @default(uuid())
  loteId         String
  lote           Lote           @relation(fields: [loteId], references: [id])
  tipo           TipoEventoLote
  estadoAnterior EstadoLote?
  estadoNuevo    EstadoLote?
  valorAnterior  Decimal?       @db.Decimal(14, 2)
  valorNuevo     Decimal?       @db.Decimal(14, 2)
  motivo         String?
  // Venta que originó el cambio, si aplica.
  ventaId        String?
  usuarioId      String
  usuario        Usuario        @relation(fields: [usuarioId], references: [id])
  createdAt      DateTime       @default(now())

  @@index([loteId, createdAt])
}

// Comprador de uno o más lotes.
model Cliente {
  id                          String        @id @default(uuid())
  nombre                      String
  documento                   String        @unique
  tipoDocumento               TipoDocumento @default(CC)
  telefono                    String?
  email                       String?
  direccion                   String?
  // Autorización de tratamiento de datos personales (Ley 1581 de 2012, RF-CLI-04): si la dio, cuándo y quién la registró.
  autorizaDatos               Boolean       @default(false)
  fechaAutorizacion           DateTime?
  autorizacionRegistradaPorId String?
  autorizacionRegistradaPor   Usuario?      @relation("AutorizacionesRegistradas", fields: [autorizacionRegistradaPorId], references: [id])
  ventas                      Venta[]
  separaciones                Separacion[]
  notificaciones              Notificacion[]
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt
}

// Apartado de un lote antes de formalizar la venta. El valor es solo informativo (lo que dejó el
// interesado); el dinero se recibe como abono a la cuota inicial cuando se formaliza la venta.
// Solo puede haber una separación ACTIVA por lote (índice parcial escrito a mano en la migración).
model Separacion {
  id                 String           @id @default(uuid())
  loteId             String
  lote               Lote             @relation(fields: [loteId], references: [id])
  // Interesado: un cliente ya registrado o solo su nombre y teléfono.
  clienteId          String?
  cliente            Cliente?         @relation(fields: [clienteId], references: [id])
  nombreInteresado   String?
  telefonoInteresado String?
  valor              Decimal?         @db.Decimal(14, 2)
  fechaLimite        DateTime?
  estado             EstadoSeparacion @default(ACTIVA)
  // Venta en la que terminó (cuando pasa a CONVERTIDA).
  ventaId            String?          @unique
  venta              Venta?           @relation(fields: [ventaId], references: [id])
  registradaPorId    String
  registradaPor      Usuario          @relation(fields: [registradaPorId], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([loteId, estado])
}

// Documento firmado de una venta (contrato, promesa, etc.). Se conservan siempre: no se borran.
model DocumentoVenta {
  id             String   @id @default(uuid())
  ventaId        String
  venta          Venta    @relation(fields: [ventaId], references: [id])
  nombreOriginal String
  ruta           String
  tipoMime       String
  tamano         Int
  descripcion    String?
  subidoPorId    String
  subidoPor      Usuario  @relation(fields: [subidoPorId], references: [id])
  createdAt      DateTime @default(now())

  @@index([ventaId])
}

// El cliente desiste de la compra. No se borra ningún abono ni recibo: solo se registra la
// decisión del gerente y qué valor se devuelve o se retiene (dato manual).
model Desistimiento {
  id              String   @id @default(uuid())
  ventaId         String   @unique
  venta           Venta    @relation(fields: [ventaId], references: [id])
  fecha           DateTime
  motivo          String
  valorDevolver   Decimal? @db.Decimal(14, 2)
  valorRetener    Decimal? @db.Decimal(14, 2)
  registradoPorId String
  registradoPor   Usuario  @relation(fields: [registradoPorId], references: [id])
  createdAt       DateTime @default(now())
}

// Persona que trajo la venta (asesor inmobiliario o referido). Se reutiliza entre
// ventas y la Etapa 2 la usa para calcular comisiones.
model Vendedor {
  id         String       @id @default(uuid())
  tipo       TipoVendedor
  nombre     String
  documento  String       @unique
  telefono   String?
  ventas     Venta[]
  comisiones Comision[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

// Transacción de venta de un Lote a un Cliente. Se guarda como historial:
// si una venta se rechaza o el cliente desiste, queda marcada en vez de borrarse,
// para no perder el rastro de por qué el lote volvió a estar disponible.
// La cuota inicial es la cuota número 0 del plan (ver Cuota); se paga con abonos como cualquier cuota.
model Venta {
  id                String                 @id @default(uuid())
  loteId            String
  lote              Lote                   @relation(fields: [loteId], references: [id])
  clienteId         String
  cliente           Cliente                @relation(fields: [clienteId], references: [id])
  vendedorId        String?
  vendedor          Vendedor?              @relation(fields: [vendedorId], references: [id])
  valorTotal        Decimal                @db.Decimal(14, 2)
  cuotaInicial      Decimal                @db.Decimal(14, 2)
  // numeroCuotas y tasaInteres solo aplican cuando formaPago = FINANCIADO.
  numeroCuotas      Int?
  tasaInteres       Decimal?               @db.Decimal(5, 2)
  formaPago         FormaPago
  fechaVenta        DateTime               @default(now())
  // Hasta cuándo se espera la cuota inicial (cuota 0); por defecto, el día de la venta.
  fechaCuotaInicial DateTime?
  estado            EstadoVenta            @default(ACTIVA)
  // Quién registró la venta (nulo en ventas anteriores al control por usuario).
  registradaPorId   String?
  registradaPor     Usuario?               @relation("VentasRegistradas", fields: [registradaPorId], references: [id])
  // Excepción: cuota inicial menor a la configurada o plazo mayor al máximo. Exige motivo y
  // la autorización de un gerente (quien tenga el permiso ventas.autorizar).
  esExcepcion       Boolean                @default(false)
  motivoExcepcion   String?
  // Quién autorizó o rechazó la excepción, cuándo y, si se rechazó, por qué.
  resueltaPorId     String?
  resueltaPor       Usuario?               @relation("VentasResueltas", fields: [resueltaPorId], references: [id])
  resueltaEn        DateTime?
  motivoRechazo     String?
  // true si esta venta fue la que dejó el lote SEPARADO mientras esperaba aprobación
  // (para liberarlo si se rechaza).
  separoElLote      Boolean                @default(false)
  cuotas            Cuota[]
  abonos            Abono[]
  documentos        DocumentoVenta[]
  desistimiento     Desistimiento?
  movimientos       MovimientoFinanciero[]
  separacion        Separacion?
  comision          Comision?
  notificaciones    Notificacion[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([loteId])
  @@index([estado])
}

// Una fila del plan de pagos de una Venta financiada.
model Cuota {
  id                    String            @id @default(uuid())
  ventaId               String
  venta                 Venta             @relation(fields: [ventaId], references: [id])
  numero                Int
  fechaVencimiento      DateTime
  valor                 Decimal           @db.Decimal(14, 2)
  estado                EstadoCuota       @default(PENDIENTE)
  aplicaciones          AplicacionAbono[]
  // Cuándo se envió el recordatorio de pago de esta cuota (null = todavía
  // no se ha enviado). Evita que el proceso diario le avise dos veces al
  // mismo cliente por la misma cuota.
  recordatorioEnviadoEn DateTime?
  notificaciones        Notificacion[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([ventaId, numero])
}

// Un pago del cliente sobre una Venta. Si se financió, normalmente se
// indica a qué Cuota corresponde (cuotaId) para poder marcarla PAGADA o
// PARCIAL; en una venta de contado, o en un abono todavía sin asignar,
// cuotaId queda nulo y el pago solo cuenta hacia el total de la venta.
// Pago de un cliente. Es inmutable: no se edita ni se borra, solo se anula (con motivo). El efecto sobre
// las cuotas está en AplicacionAbono y el comprobante de caja en Recibo. Los triggers de la migración
// impiden cambiar o borrar un abono por cualquier camino.
model Abono {
  id              String            @id @default(uuid())
  ventaId         String
  venta           Venta             @relation(fields: [ventaId], references: [id])
  fecha           DateTime
  valor           Decimal           @db.Decimal(14, 2)
  medioPago       MedioPago
  // Cuenta donde entró el dinero (obligatoria si no es efectivo) y referencia de la transacción.
  cuentaDestinoId String?
  cuentaDestino   CuentaBancaria?   @relation(fields: [cuentaDestinoId], references: [id])
  referencia      String?
  // Soporte de pago del cliente (foto o PDF). El nombre de la columna es histórico.
  comprobanteUrl  String?
  estado          EstadoAbono       @default(ACTIVO)
  // Quién lo registró (nulo en abonos anteriores al control por usuario).
  registradoPorId String?
  registradoPor   Usuario?          @relation("AbonosRegistrados", fields: [registradoPorId], references: [id])
  anuladoPorId    String?
  anuladoPor      Usuario?          @relation("AbonosAnulados", fields: [anuladoPorId], references: [id])
  anuladoEn       DateTime?
  motivoAnulacion String?
  // Verificación contra el extracto del banco (RF-REC-10): los pagos que no son en efectivo nacen POR_VERIFICAR.
  // Un abono por verificar cuenta igual en el saldo y tiene su recibo; la marca solo dice que falta confirmarlo.
  verificacion       EstadoVerificacion @default(NO_REQUIERE)
  verificadoPorId    String?
  verificadoPor      Usuario?           @relation("AbonosVerificados", fields: [verificadoPorId], references: [id], onDelete: Restrict)
  verificadoEn       DateTime?
  notaVerificacion   String?
  aplicaciones    AplicacionAbono[]
  recibo          Recibo?
  notificaciones  Notificacion[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([ventaId, estado])
}

// Cuánto de un abono se aplicó a cada cuota (un abono puede cubrir varias cuotas, o solo parte de una).
// Solo se inserta: al anular el abono estas filas se conservan y dejan de contar.
model AplicacionAbono {
  id      String  @id @default(uuid())
  abonoId String
  abono   Abono   @relation(fields: [abonoId], references: [id])
  cuotaId String
  cuota   Cuota   @relation(fields: [cuotaId], references: [id])
  valor   Decimal @db.Decimal(14, 2)

  @@index([abonoId])
  @@index([cuotaId])
}

// Contador por serie (recibos de caja, recibos históricos, luego nómina). El número se toma dentro de la
// transacción que lo usa: dos operaciones simultáneas nunca reciben el mismo número y, si la operación
// falla, el número no se consume (sin huecos).
model Consecutivo {
  serie  String @id
  ultimo Int    @default(0)
}

// Recibo de caja emitido por un abono. El contenido es una "fotografía" de lo que se emitió: si luego cambia
// el nombre del cliente o la configuración, el recibo no cambia. No se edita ni se borra (trigger en la base).
// Si el abono se anula, el recibo se muestra con la marca ANULADO (el estado vive en Abono).
model Recibo {
  id          String   @id @default(uuid())
  serie       String
  numero      Int
  numeroTexto String   @unique
  abonoId     String   @unique
  abono       Abono    @relation(fields: [abonoId], references: [id])
  // true para los recibos de abonos importados o anteriores al sistema (serie H-), que no mezclan la numeración real.
  esHistorico Boolean  @default(false)
  contenido   Json
  createdAt   DateTime @default(now())

  @@unique([serie, numero])
}

// Egreso o ingreso que no viene de un abono de cliente (arriendo, materiales, otros servicios, la
// devolución de un desistimiento...). Los pagos de clientes por lotes ya son Abono y no se duplican
// aquí: los totales y el detalle de finanzas los suman desde su propia tabla.
//
// Es inmutable (la base lo impide): si hay un error se anula con motivo y se registra uno nuevo.
// Los egresos exigen soporte adjunto o el motivo por el que no hay.
model MovimientoFinanciero {
  id                 String            @id @default(uuid())
  tipo               TipoMovimiento
  fecha              DateTime
  valor              Decimal           @db.Decimal(14, 2)
  descripcion        String
  // Sin proyecto = gasto o ingreso general de la empresa.
  proyectoId         String?
  proyecto           Proyecto?         @relation(fields: [proyectoId], references: [id])
  // Un egreso lleva categoría de gasto y un ingreso categoría de ingreso (lo exige la base).
  categoriaGastoId   String?
  categoriaGasto     CategoriaGasto?   @relation(fields: [categoriaGastoId], references: [id])
  categoriaIngresoId String?
  categoriaIngreso   CategoriaIngreso? @relation(fields: [categoriaIngresoId], references: [id])
  medioPago          MedioPago
  // Cuenta de donde salió (egreso) o a donde entró (ingreso) el dinero; obligatoria si no es efectivo.
  cuentaId           String?
  cuenta             CuentaBancaria?   @relation(fields: [cuentaId], references: [id])
  referencia         String?
  // Quién recibió o pagó, y el número de su factura o recibo (RF-EGR-09).
  terceroNombre      String?
  terceroDocumento   String?
  numeroDocumento    String?
  soporteRuta        String?
  motivoSinSoporte   String?
  origen             OrigenMovimiento  @default(MANUAL)
  // Venta de la que viene (solo la devolución de un desistimiento).
  ventaId            String?
  venta              Venta?            @relation(fields: [ventaId], references: [id])
  // Proyectos de maquinaria (RF-MAQ-03 y 04): el equipo al que se asigna el movimiento, o "gasto general de la flota";
  // y, en el ingreso por alquiler, el período alquilado.
  equipoId           String?
  equipo             Equipo?           @relation(fields: [equipoId], references: [id], onDelete: Restrict)
  flota              Boolean           @default(false)
  periodoDesde       DateTime?         @db.Date
  periodoHasta       DateTime?         @db.Date
  // La comisión que este egreso pagó (solo cuando origen = COMISION).
  comision           Comision?
  estado             EstadoMovimiento  @default(ACTIVO)
  registradoPorId    String?
  registradoPor      Usuario?          @relation("MovimientosRegistrados", fields: [registradoPorId], references: [id])
  anuladoPorId       String?
  anuladoPor         Usuario?          @relation("MovimientosAnulados", fields: [anuladoPorId], references: [id])
  anuladoEn          DateTime?
  motivoAnulacion    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([proyectoId, fecha])
  @@index([fecha])
  @@index([estado])
  @@index([equipoId])
}

// Cierre de caja (RF-CAJ-01 a 06): resume lo que entró y salió de la caja de la empresa en un período, compara el
// efectivo esperado con el contado y pasa por la aprobación del gerente.
//
// - Los períodos son consecutivos y no se solapan (lo exige la base de datos): cada cierre empieza el día
//   siguiente al anterior, así que ningún movimiento queda sin cubrir.
// - El número se asigna al cerrar por primera vez (un borrador que se descarta no gasta número).
// - "contenido" es la fotografía de los totales y movimientos al cerrar: un cierre cerrado o aprobado no cambia
//   aunque después se anule algo (esa anulación aparece en el cierre siguiente).
// - Un cierre aprobado es inmutable y solo un borrador se puede descartar (lo hace la base de datos).
model CierreCaja {
  id                    String                @id @default(uuid())
  // Se asigna al cerrar por primera vez.
  numero                Int?                  @unique
  numeroTexto           String?               @unique
  tipo                  TipoCierre
  // Días calendario, ambos incluidos.
  desde                 DateTime              @db.Date
  hasta                 DateTime              @db.Date
  estado                EstadoCierre          @default(BORRADOR)
  // El efectivo contado del cierre aprobado anterior; en el primer cierre lo escribe el administrador.
  efectivoInicial       Decimal               @db.Decimal(14, 2)
  efectivoEsperado      Decimal?              @db.Decimal(14, 2)
  efectivoContado       Decimal?              @db.Decimal(14, 2)
  diferencia            Decimal?              @db.Decimal(14, 2)
  explicacionDiferencia String?
  contenido             Json?
  creadoPorId           String
  creadoPor             Usuario               @relation("CierresCreados", fields: [creadoPorId], references: [id])
  cerradoPorId          String?
  cerradoPor            Usuario?              @relation("CierresCerrados", fields: [cerradoPorId], references: [id])
  cerradoEn             DateTime?
  resueltoPorId         String?
  resueltoPor           Usuario?              @relation("CierresResueltos", fields: [resueltoPorId], references: [id])
  resueltoEn            DateTime?
  observacionGerente    String?
  historial             CierreCajaHistorial[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([estado])
  @@index([desde, hasta])
}

// Quién hizo cada paso de un cierre y cuándo. Solo se agrega: no se edita ni se borra.
model CierreCajaHistorial {
  id             String        @id @default(uuid())
  cierreId       String
  cierre         CierreCaja    @relation(fields: [cierreId], references: [id])
  estadoAnterior EstadoCierre?
  estadoNuevo    EstadoCierre
  usuarioId      String
  usuario        Usuario       @relation(fields: [usuarioId], references: [id])
  observacion    String?
  createdAt      DateTime      @default(now())

  @@index([cierreId])
}

// Auditoría (RF-AUD-01 a 03): una fila por cada acción de una persona sobre ventas, lotes, dinero, cierres,
// configuración y usuarios, con quién, cuándo y los valores ANTES y DESPUÉS. Se escribe en la misma transacción
// que la acción (si una falla, la otra también) y la base de datos impide editar o borrar cualquier fila.
// Nunca guarda contraseñas, hashes ni tokens.
model RegistroAuditoria {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  usuarioId     String
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
  // Nombre y correo tal como estaban ese día, por si después cambian.
  usuarioNombre String
  usuarioEmail  String
  // Códigos del catálogo de auditoria/auditoria.ts (p. ej. ABONO_ANULAR) y tipo de registro (p. ej. ABONO).
  accion        String
  entidad       String
  entidadId     String?
  // La acción contada en español, para leerla sin abrir los valores.
  resumen       String
  antes         Json?
  despues       Json?

  @@index([createdAt])
  @@index([usuarioId, createdAt])
  @@index([entidad, createdAt])
  @@index([entidad, entidadId])
}

// Empleado de la empresa (no de un proyecto en particular).
model Trabajador {
  id           String           @id @default(uuid())
  nombre       String
  documento    String           @unique
  cargo        String
  salarioBase  Decimal          @db.Decimal(14, 2)
  fechaIngreso DateTime
  telefono     String?
  email        String?
  estado       EstadoTrabajador @default(ACTIVO)
  pagos        PagoNomina[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

// Pago de nómina de un Trabajador por un período. salarioBase y
// valorPagado quedan como una foto de ese momento (igual que Cuota.valor
// en Ventas): si el salario del trabajador cambia después, los pagos ya
// hechos no deben cambiar retroactivamente.
model PagoNomina {
  id            String          @id @default(uuid())
  trabajadorId  String
  trabajador    Trabajador      @relation(fields: [trabajadorId], references: [id])
  periodoInicio DateTime
  periodoFin    DateTime
  salarioBase   Decimal         @db.Decimal(14, 2)
  valorPagado   Decimal         @db.Decimal(14, 2)
  fechaPago     DateTime
  // Con qué se pagó y de qué cuenta salió el dinero: el cierre de caja necesita saber cuánto salió en efectivo.
  medioPago     MedioPago
  cuentaId      String?
  cuenta        CuentaBancaria? @relation(fields: [cuentaId], references: [id])
  novedades     NovedadNomina[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

// Horas extra, descuento o incapacidad aplicada a un pago de nómina.
// valor es un monto en pesos, no horas x tarifa: liquidar recargos
// nocturnos, límites de incapacidad de la EPS, etc. está fuera de este
// alcance — aquí solo se registra el efecto final en pesos.
model NovedadNomina {
  id          String      @id @default(uuid())
  pagoId      String
  pago        PagoNomina  @relation(fields: [pagoId], references: [id])
  tipo        TipoNovedad
  valor       Decimal     @db.Decimal(14, 2)
  descripcion String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// Datos de la empresa y parámetros de negocio. Es una sola fila (id = 1,
// reforzado con un CHECK en la migración): la instalación pertenece a una
// única empresa. Nada de esto debe estar escrito en el código.
model ConfiguracionEmpresa {
  id               Int     @id @default(1)
  razonSocial      String
  nombreComercial  String
  nit              String
  direccion        String?
  telefonos        String?
  correo           String?
  // Ruta relativa en StorageService; null = se muestra el logo genérico.
  logoRuta         String?
  colorPrimario    String  @default("#2563eb")
  textoLegalRecibo String?
  // Nombre de la plataforma (el producto), distinto del nombre comercial de
  // la empresa cliente. Es el único lugar donde vive ese texto.
  nombreProducto   String  @default("Urbanix")

  // Parámetros de negocio (RF-CFG-03 a RF-CFG-05). Los porcentajes y tasas
  // se guardan como porcentaje (30 = 30 %).
  porcentajeCuotaInicial  Decimal  @default(30) @db.Decimal(5, 2)
  plazoMaximoMeses        Int      @default(12)
  tasaFinanciacionMensual Decimal  @default(0) @db.Decimal(5, 2)
  // null = el gerente todavía no la define: no se calcula interés de mora.
  tasaMoraMensual         Decimal? @db.Decimal(5, 2)
  diasGraciaMora          Int      @default(0)
  diasSemaforoAmarillo    Int      @default(5)
  prefijoRecibo           String   @default("RC-")
  diasAntesRecordatorio   Int      @default(3)
  // Cada cuántos días se le repite el aviso de mora a una venta con cuotas vencidas (RF-NOT-03).
  diasEntreAvisosMora     Int      @default(7)
  // Si el recibo de cada abono nuevo sale solo al correo del cliente (RF-NOT-01).
  enviarReciboPorCorreo   Boolean  @default(true)
  // Desde cuántos días de antigüedad un abono por verificar se resalta en rojo en el panel (RF-NOT-07).
  diasAlertaVerificacion  Int      @default(3)
  // Recuperación de contraseña por correo (RF-USR-06): cuánto vale el enlace y cuántos se pueden pedir por hora y cuenta.
  minutosVigenciaRecuperacion Int  @default(60)
  recuperacionesPorHora       Int  @default(3)
  // Seguridad de sesión: bloqueo tras intentos fallidos y cierre por inactividad.
  intentosMaximosLogin    Int      @default(5)
  minutosBloqueoLogin     Int      @default(15)
  minutosInactividad      Int      @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Cuenta de recaudo. Se desactiva, no se borra: un recibo viejo puede
// haberse pagado a esta cuenta.
model CuentaBancaria {
  id          String                 @id @default(uuid())
  banco       String
  tipo        TipoCuenta
  numero      String
  alias       String
  activa      Boolean                @default(true)
  abonos      Abono[]
  movimientos MovimientoFinanciero[]
  pagosNomina PagoNomina[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([banco, numero])
}

// Categoría de gasto. Las marcadas esSistema (Nómina, Comisiones) las usan
// procesos automáticos de etapas posteriores y no se pueden desactivar.
model CategoriaGasto {
  id             String                 @id @default(uuid())
  nombre         String                 @unique
  activa         Boolean                @default(true)
  esSistema      Boolean                @default(false)
  // RF-MAQ-06: una categoría propia de la maquinaria solo se ofrece (y solo se acepta) en proyectos de maquinaria.
  soloMaquinaria Boolean                @default(false)
  movimientos    MovimientoFinanciero[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

// Estado operativo de un equipo de maquinaria (RF-MAQ-01). Distinto de la baja: un equipo dado de baja se conserva
// con todos sus movimientos pero ya no recibe movimientos nuevos (RF-MAQ-07).
enum EstadoEquipo {
  ACTIVO
  EN_MANTENIMIENTO
  FUERA_DE_SERVICIO
}

// Lista de tipos de equipo que administra el gerente (RF-MAQ-02): excavadora, retroexcavadora, volqueta...
// Se desactivan, no se borran.
model TipoEquipo {
  id        String   @id @default(uuid())
  nombre    String   @unique
  activo    Boolean  @default(true)
  equipos   Equipo[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Equipo de maquinaria de un proyecto de tipo Maquinaria (RF-MAQ-01). Nunca se borra (lo impide la base de datos):
// se da de baja con motivo y sus movimientos se conservan (RF-MAQ-07).
model Equipo {
  id           String                 @id @default(uuid())
  proyectoId   String
  proyecto     Proyecto               @relation(fields: [proyectoId], references: [id])
  nombre       String
  tipoEquipoId String
  tipoEquipo   TipoEquipo             @relation(fields: [tipoEquipoId], references: [id])
  marca        String?
  modelo       String?
  anio         Int?
  // Placa o serie: no se repite entre equipos (índice único escrito a mano en la migración).
  placaSerie   String?
  estado       EstadoEquipo           @default(ACTIVO)
  bajaEn       DateTime?
  bajaMotivo   String?
  bajaPorId    String?
  bajaPor      Usuario?               @relation("EquiposDadosDeBaja", fields: [bajaPorId], references: [id])
  movimientos  MovimientoFinanciero[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([proyectoId])
  @@index([tipoEquipoId])
}

// Categoría de ingreso (RF-CFG-11): para los ingresos que no son cuotas ni abonos de lotes (esos se
// suman solos desde los abonos), por ejemplo un anticipo de remodelación u otros servicios.
model CategoriaIngreso {
  id          String                 @id @default(uuid())
  nombre      String                 @unique
  activa      Boolean                @default(true)
  esSistema   Boolean                @default(false)
  movimientos MovimientoFinanciero[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

// Una fila por valor de MedioPago: dice si está habilitado para registrar
// abonos y egresos.
model MedioPagoConfig {
  medio     MedioPago @id
  activo    Boolean   @default(true)
  // Los abonos con este medio quedan "por verificar" hasta que el administrador los confirma contra el extracto
  // (RF-REC-10). El efectivo no se verifica en el banco: se cuadra en el cierre de caja.
  requiereVerificacion Boolean @default(true)
  updatedAt DateTime  @updatedAt
}

// Valor fijo de comisión por tipo de vendedor.
model ComisionTipoVendedor {
  tipo      TipoVendedor @id
  valor     Decimal      @db.Decimal(14, 2)
  updatedAt DateTime     @updatedAt
}

// Comisión de una venta (RF-COM-01 a 04): una por venta con vendedor, con el valor fijo de su tipo VIGENTE al generarla
// (si luego cambia la configuración, las ya generadas no cambian). Se genera sola cuando la venta queda ACTIVA.
// Al pagarla se crea su egreso (categoría Comisiones) en la misma transacción. Nunca se borra (la base lo impide) y
// una anulada no vuelve a cambiar; el valor, la venta y el vendedor tampoco se modifican.
model Comision {
  id              String                @id @default(uuid())
  ventaId         String                @unique
  venta           Venta                 @relation(fields: [ventaId], references: [id])
  vendedorId      String
  vendedor        Vendedor              @relation(fields: [vendedorId], references: [id])
  // El tipo del vendedor al momento de generarla (el vendedor podría cambiar de tipo en el futuro).
  tipoVendedor    TipoVendedor
  valor           Decimal               @db.Decimal(14, 2)
  estado          EstadoComision        @default(PENDIENTE)
  // Pago: el egreso trae la fecha, el medio, la cuenta, la referencia y el soporte.
  movimientoId    String?               @unique
  movimiento      MovimientoFinanciero? @relation(fields: [movimientoId], references: [id], onDelete: Restrict)
  pagadaPorId     String?
  pagadaPor       Usuario?              @relation("ComisionesPagadas", fields: [pagadaPorId], references: [id], onDelete: Restrict)
  pagadaEn        DateTime?
  // Anulación (de una pendiente o de una pagada): quién, cuándo y por qué.
  anuladaPorId    String?
  anuladaPor      Usuario?              @relation("ComisionesAnuladas", fields: [anuladaPorId], references: [id], onDelete: Restrict)
  anuladaEn       DateTime?
  motivoAnulacion String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([vendedorId])
  @@index([estado])
}

// Verificación de un abono contra el extracto bancario (RF-REC-10).
enum EstadoVerificacion {
  NO_REQUIERE
  POR_VERIFICAR
  VERIFICADO
}

// Qué se le avisa al cliente (RF-NOT-01 a 03).
enum TipoNotificacion {
  RECIBO
  RECORDATORIO
  MORA
}

enum CanalNotificacion {
  CORREO
  WHATSAPP
}

// Resultado de un intento. WhatsApp no se envía desde el sistema (solo se abre el enlace con el mensaje listo),
// por eso su único estado posible es ENLACE_ABIERTO.
enum EstadoNotificacion {
  ENVIADA
  FALLIDA
  OMITIDA
  ENLACE_ABIERTO
}

// Historial de avisos a clientes (RF-NOT-06): un registro por intento, con su resultado. Solo se inserta (la base
// impide editar o borrar). Un índice único parcial, escrito a mano en la migración, garantiza que una cuota no
// reciba dos recordatorios por correo enviados (RF-NOT-05).
model Notificacion {
  id           String             @id @default(uuid())
  createdAt    DateTime           @default(now())
  tipo         TipoNotificacion
  canal        CanalNotificacion
  estado       EstadoNotificacion
  clienteId    String
  cliente      Cliente            @relation(fields: [clienteId], references: [id])
  ventaId      String
  venta        Venta              @relation(fields: [ventaId], references: [id])
  cuotaId      String?
  cuota        Cuota?             @relation(fields: [cuotaId], references: [id], onDelete: Restrict)
  abonoId      String?
  abono        Abono?             @relation(fields: [abonoId], references: [id], onDelete: Restrict)
  // Correo o teléfono al que iba, tal como estaba ese día.
  destinatario String?
  asunto       String?
  // Por qué falló o se omitió (mensaje de error, "sin correo", "correo no configurado"...).
  detalle      String?
  // Quién lo disparó; nulo cuando lo hizo el sistema (cron).
  usuarioId    String?
  usuario      Usuario?           @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([clienteId, createdAt])
  @@index([ventaId, tipo, canal, estado, createdAt])
}

// Enlace de un solo uso para recuperar la contraseña por correo (RF-USR-06). Del token que viaja por correo solo se
// guarda su huella SHA-256: quien viera la base de datos no podría usar los enlaces. Solo se inserta; lo único que
// cambia es marcarlo como usado, una vez (un trigger, escrito a mano en la migración, lo garantiza).
model RecuperacionPassword {
  id        String    @id @default(uuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  venceEn   DateTime
  usadoEn   DateTime?

  @@index([usuarioId, createdAt])
}
