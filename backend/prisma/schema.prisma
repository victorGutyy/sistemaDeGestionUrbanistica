// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  // Dentro de src/: el compilador de Nest (tsconfig.build.json) exige que
  // todo lo importado esté bajo rootDir "./src".
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoProyecto {
  ACTIVO
  FINALIZADO
}

enum EstadoLote {
  DISPONIBLE
  RESERVADO
  VENDIDO
}

enum FormaPago {
  CONTADO
  FINANCIADO
}

enum EstadoVenta {
  ACTIVA
  CANCELADA
}

enum EstadoCuota {
  PENDIENTE
  PARCIAL
  PAGADA
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  CHEQUE
  TARJETA
}

enum TipoMovimiento {
  INGRESO
  GASTO
}

enum EstadoTrabajador {
  ACTIVO
  INACTIVO
}

enum TipoNovedad {
  HORAS_EXTRA
  DESCUENTO
  INCAPACIDAD
}

// Predio de mayor extensión que la empresa compra y subdivide en lotes.
model Proyecto {
  id          String                 @id @default(uuid())
  nombre      String
  ubicacion   String?
  areaTotal   Decimal                @db.Decimal(12, 2)
  valorCompra Decimal?               @db.Decimal(14, 2)
  fechaCompra DateTime?
  estado      EstadoProyecto         @default(ACTIVO)
  lotes       Lote[]
  movimientos MovimientoFinanciero[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

// Subdivisión individual de un Proyecto, en venta.
model Lote {
  id         String     @id @default(uuid())
  proyectoId String
  proyecto   Proyecto   @relation(fields: [proyectoId], references: [id])
  numero     String
  area       Decimal    @db.Decimal(10, 2)
  valorVenta Decimal    @db.Decimal(14, 2)
  estado     EstadoLote @default(DISPONIBLE)
  ventas     Venta[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([proyectoId, numero])
}

// Comprador de uno o más lotes.
model Cliente {
  id        String   @id @default(uuid())
  nombre    String
  documento String   @unique
  telefono  String?
  email     String?
  direccion String?
  ventas    Venta[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Transacción de venta de un Lote a un Cliente. Se guarda como historial:
// si una venta se cancela, queda marcada CANCELADA en vez de borrarse, para
// no perder el rastro de por qué el lote volvió a estar disponible.
model Venta {
  id           String      @id @default(uuid())
  loteId       String
  lote         Lote        @relation(fields: [loteId], references: [id])
  clienteId    String
  cliente      Cliente     @relation(fields: [clienteId], references: [id])
  valorTotal   Decimal     @db.Decimal(14, 2)
  cuotaInicial Decimal     @db.Decimal(14, 2)
  // numeroCuotas y tasaInteres solo aplican cuando formaPago = FINANCIADO.
  numeroCuotas Int?
  tasaInteres  Decimal?    @db.Decimal(5, 2)
  formaPago    FormaPago
  fechaVenta   DateTime    @default(now())
  estado       EstadoVenta @default(ACTIVA)
  cuotas       Cuota[]
  abonos       Abono[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// Una fila del plan de pagos de una Venta financiada.
model Cuota {
  id               String      @id @default(uuid())
  ventaId          String
  venta            Venta       @relation(fields: [ventaId], references: [id])
  numero           Int
  fechaVencimiento DateTime
  valor            Decimal     @db.Decimal(14, 2)
  estado           EstadoCuota @default(PENDIENTE)
  abonos           Abono[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([ventaId, numero])
}

// Un pago del cliente sobre una Venta. Si se financió, normalmente se
// indica a qué Cuota corresponde (cuotaId) para poder marcarla PAGADA o
// PARCIAL; en una venta de contado, o en un abono todavía sin asignar,
// cuotaId queda nulo y el pago solo cuenta hacia el total de la venta.
model Abono {
  id             String    @id @default(uuid())
  ventaId        String
  venta          Venta     @relation(fields: [ventaId], references: [id])
  cuotaId        String?
  cuota          Cuota?    @relation(fields: [cuotaId], references: [id])
  fecha          DateTime
  valor          Decimal   @db.Decimal(14, 2)
  medioPago      MedioPago
  comprobanteUrl String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Gasto o ingreso general de la empresa, no ligado necesariamente a un
// proyecto (arriendo de oficina, venta de un excedente, etc.). Los pagos
// de clientes por la venta de lotes ya se registran como Abono; no se
// duplican aquí, el consolidado de caja los suma desde su propia tabla.
model MovimientoFinanciero {
  id         String         @id @default(uuid())
  tipo       TipoMovimiento
  fecha      DateTime
  valor      Decimal        @db.Decimal(14, 2)
  concepto   String
  proyectoId String?
  proyecto   Proyecto?      @relation(fields: [proyectoId], references: [id])
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

// Empleado de la empresa (no de un proyecto en particular).
model Trabajador {
  id           String           @id @default(uuid())
  nombre       String
  documento    String           @unique
  cargo        String
  salarioBase  Decimal          @db.Decimal(14, 2)
  fechaIngreso DateTime
  telefono     String?
  email        String?
  estado       EstadoTrabajador @default(ACTIVO)
  pagos        PagoNomina[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

// Pago de nómina de un Trabajador por un período. salarioBase y
// valorPagado quedan como una foto de ese momento (igual que Cuota.valor
// en Ventas): si el salario del trabajador cambia después, los pagos ya
// hechos no deben cambiar retroactivamente.
model PagoNomina {
  id            String          @id @default(uuid())
  trabajadorId  String
  trabajador    Trabajador      @relation(fields: [trabajadorId], references: [id])
  periodoInicio DateTime
  periodoFin    DateTime
  salarioBase   Decimal         @db.Decimal(14, 2)
  valorPagado   Decimal         @db.Decimal(14, 2)
  fechaPago     DateTime
  novedades     NovedadNomina[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

// Horas extra, descuento o incapacidad aplicada a un pago de nómina.
// valor es un monto en pesos, no horas x tarifa: liquidar recargos
// nocturnos, límites de incapacidad de la EPS, etc. está fuera de este
// alcance — aquí solo se registra el efecto final en pesos.
model NovedadNomina {
  id          String      @id @default(uuid())
  pagoId      String
  pago        PagoNomina  @relation(fields: [pagoId], references: [id])
  tipo        TipoNovedad
  valor       Decimal     @db.Decimal(14, 2)
  descripcion String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}
