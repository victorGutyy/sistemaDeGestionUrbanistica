# Plantilla de variables de entorno. Copia este archivo a ".env" y completa
# con tus valores reales — "env" nunca se sube a git.

# Cadena de conexión a PostgreSQL.
DATABASE_URL="postgresql://usuario:password@localhost:5432/sistema_urbanismo?schema=public"

# Secreto usado para firmar los tokens JWT. Usa un valor largo y aleatorio en cada entorno.
JWT_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

# Puerto donde escucha la API.
PORT=3000

# Origen permitido por CORS (la URL donde corre el frontend).
FRONTEND_URL="http://localhost:5173"

# La tasa de mora, los días del semáforo y los días de anticipación del
# recordatorio ya NO van aquí: el gerente los edita en la app (Configuración).

# Correo para los recordatorios de pago (SMTP). Con Gmail: crea una
# "contraseña de aplicación" en https://myaccount.google.com/security,
# nunca uses tu contraseña normal de la cuenta aquí.
# De SMTP_FROM solo se usa la dirección; el nombre que ve el cliente sale de
# la configuración de la empresa.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="tu-correo@gmail.com"
SMTP_PASS="contraseña-de-aplicación-de-16-caracteres"
SMTP_FROM="tu-correo@gmail.com"

# Solo para sembrar la primera cuenta (rol de mayor nivel) con:
# npx prisma db seed (sin estas variables, el seed solo carga la configuración)
# Después de correrlo, borra estas tres líneas del .env: la cuenta ya
# quedó creada en la base de datos.
SEED_ADMIN_NOMBRE="Tu nombre"
SEED_ADMIN_EMAIL="tu-correo@ejemplo.com"
SEED_ADMIN_PASSWORD="una-contraseña-de-al-menos-8-caracteres"
