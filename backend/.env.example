# Plantilla de variables de entorno. Copia este archivo a ".env" y completa
# con tus valores reales — "env" nunca se sube a git.

# Cadena de conexión a PostgreSQL.
DATABASE_URL="postgresql://usuario:password@localhost:5432/sistema_urbanismo?schema=public"

# Secreto usado para firmar los tokens JWT. Usa un valor largo y aleatorio en cada entorno.
JWT_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

# Puerto donde escucha la API.
PORT=3000

# Origen permitido por CORS (la URL donde corre el frontend).
FRONTEND_URL="http://localhost:5173"

# La tasa de mora, los días del semáforo y los días de anticipación del
# recordatorio ya NO van aquí: el gerente los edita en la app (Configuración).

# Correo para los avisos a los clientes (SMTP): recibos, recordatorios, avisos de mora
# y enlaces de recuperación de contraseña. Se recomienda una cuenta EXCLUSIVA para el
# sistema, a nombre de la empresa, distinta del correo de trabajo.
# Con Gmail: activa la verificación en dos pasos y crea una "contraseña de aplicación"
# en https://myaccount.google.com/apppasswords; nunca uses la contraseña normal.
# De SMTP_FROM solo se usa la dirección; el nombre que ve el cliente sale de la
# configuración de la empresa. Las respuestas de los clientes llegan al "Correo de
# contacto" de Configuración → Empresa (si es distinto de esta cuenta).
# Para comprobar el envío: Configuración → Correo de avisos → "Enviar correo de prueba".
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="tu-correo@gmail.com"
SMTP_PASS="contraseña-de-aplicación-de-16-caracteres"
SMTP_FROM="tu-correo@gmail.com"

# Solo para sembrar la primera cuenta (rol de mayor nivel) con:
# npx prisma db seed (sin estas variables, el seed solo carga la configuración)
# Después de correrlo, borra estas tres líneas del .env: la cuenta ya
# quedó creada en la base de datos.
SEED_ADMIN_NOMBRE="Tu nombre"
SEED_ADMIN_EMAIL="tu-correo@ejemplo.com"
SEED_ADMIN_PASSWORD="una-contraseña-de-al-menos-8-caracteres"

# Límite de peticiones por dirección IP en las rutas públicas (iniciar sesión, pedir y usar el enlace de recuperación de
# contraseña). OPCIONAL: sin estas variables rigen los valores de reserva (login 10 por minuto, recuperar 5 por hora,
# restablecer 10 por hora). Para desarrollo o pruebas se apaga con LIMITE_POR_IP=desactivado.
# LIMITE_LOGIN_PETICIONES=10
# LIMITE_LOGIN_SEGUNDOS=60
# LIMITE_RECUPERAR_PETICIONES=5
# LIMITE_RECUPERAR_SEGUNDOS=3600
# LIMITE_RESTABLECER_PETICIONES=10
# LIMITE_RESTABLECER_SEGUNDOS=3600
# LIMITE_POR_IP=desactivado
