# Plantilla de variables de entorno. Copia este archivo a ".env" y completa
# con tus valores reales — "env" nunca se sube a git.

# Cadena de conexión a PostgreSQL.
DATABASE_URL="postgresql://usuario:password@localhost:5432/sistema_urbanismo?schema=public"

# Secreto usado para firmar los tokens JWT. Usa un valor largo y aleatorio en cada entorno.
JWT_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

# Puerto donde escucha la API.
PORT=3000

# Origen permitido por CORS (la URL donde corre el frontend).
FRONTEND_URL="http://localhost:5173"
