[Unit]
Description=Balder: prueba mensual de restauración (restaura la última copia en una base temporal y la compara)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/usr/bin/bash /opt/balder/fuente/deploy/produccion/respaldos/restaurar.sh probar
Nice=10
TimeoutStartSec=2h
