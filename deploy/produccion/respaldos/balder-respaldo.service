[Unit]
Description=Balder: copia de seguridad diaria cifrada (base de datos, adjuntos y secretos)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
# Se llama con bash para no depender de permisos de ejecución del archivo.
ExecStart=/usr/bin/bash /opt/balder/fuente/deploy/produccion/respaldos/respaldar.sh
Nice=10
TimeoutStartSec=2h
