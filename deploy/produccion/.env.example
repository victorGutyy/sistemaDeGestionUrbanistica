# Plantilla del archivo .env de PRODUCCIÓN. La copia real vive solo en el servidor (/opt/balder/.env, permisos 600)
# y la crea el guion desplegar.sh con contraseñas generadas al azar. NUNCA se sube a Git ni se pega en un chat.

# Dirección pública del sistema (debe apuntar al servidor por DNS).
DOMINIO=sistema.balderingenieria.com

# Base de datos (la contraseña se genera sola; solo letras y números, para que sirva dentro de una URL).
POSTGRES_DB=sistema_urbanismo
POSTGRES_USER=balder
POSTGRES_PASSWORD=__SE_GENERA_SOLA__

# Firma de las sesiones. Si se cambia, todas las personas deben volver a ingresar.
JWT_SECRET=__SE_GENERA_SOLO__
JWT_EXPIRES_IN=8h

# Correo de avisos (ver backend/.env.example). Con Gmail: contraseña de APLICACIÓN, no la normal.
# Mientras estén vacíos, los avisos a los clientes quedan como "omitida" y no sale ningún correo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Límite de peticiones por dirección IP en las rutas públicas (iniciar sesión, pedir y usar el enlace de recuperación).
# OPCIONAL: déjalos comentados y rigen los valores de reserva (login 10 por minuto, recuperar 5 por hora, restablecer 10 por hora).
# LIMITE_LOGIN_PETICIONES=10
# LIMITE_LOGIN_SEGUNDOS=60
# LIMITE_RECUPERAR_PETICIONES=5
# LIMITE_RECUPERAR_SEGUNDOS=3600
# LIMITE_RESTABLECER_PETICIONES=10
# LIMITE_RESTABLECER_SEGUNDOS=3600
